
import cv2
import numpy as np

def foreground_subtraction():
    img = cv2.imread("input.jpg")

    if img is None:
        print("Image not found")
        return

    hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)

    lower = np.array([0, 0, 0])
    upper = np.array([180, 255, 100])

    mask = cv2.inRange(hsv, lower, upper)

    result = cv2.bitwise_and(img, img, mask=cv2.bitwise_not(mask))

    cv2.imshow("Original Image", img)
    cv2.imshow("Foreground Mask", cv2.bitwise_not(mask))
    cv2.imshow("Foreground Subtraction", result)

    cv2.waitKey(0)
    cv2.destroyAllWindows()

foreground_subtraction()
